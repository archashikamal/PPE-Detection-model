# Backend Environment Variables
# Copy to .env for local/server overrides

# Port and Host (used by uvicorn)
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed origins for CORS (e.g., https://my-frontend.vercel.app)
# Defaults to localhost dev servers if unset. Set to * to allow all (credentials disabled).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional custom paths (defaults to backend directory relative paths)
# MODEL_PATH=../models/best.pt
# DATABASE_PATH=ppe_compliance.db
# UPLOAD_DIR=uploads
# THUMBNAIL_DIR=thumbnails
