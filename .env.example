# Root Environment Configuration Template
# For Docker Compose / Unified Deployment

# Backend Port
BACKEND_PORT=8000

# Frontend Port
FRONTEND_PORT=5173

# Frontend -> Backend Connection (set in production to public URL or domain)
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# Backend CORS Allowed Origins (comma-separated, e.g., https://my-frontend.domain.com)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
